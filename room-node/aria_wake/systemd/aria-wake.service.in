# EliteDesk home wake endpoint - detector. Installed by ctl.sh (paths filled in).
[Unit]
StartLimitIntervalSec=0
Description=Aria "Hey Aria" wake-word listener (EliteDesk home endpoint)
After=pipewire.service pulseaudio.service sound.target

[Service]
Type=simple
WorkingDirectory=@DIR@
EnvironmentFile=%h/.config/aria-wake/aria-wake.env
Environment=ARIA_WAKE_ENABLE=1
Environment=PYTHONUNBUFFERED=1
ExecStart=@DIR@/.venv/bin/python @DIR@/aria_wake.py
# The listener exits non-zero when capture ends or the phrase is refused;
# systemd restarts it (it never keeps running deaf).
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
