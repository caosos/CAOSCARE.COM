# ~/.config/aria-wake/aria-wake.env  (copied here by ctl.sh install if absent)
# Audio endpoint. Find names with:  pactl list short sources ; pactl list short sinks
# Leave blank to use the PulseAudio defaults.
PULSE_SOURCE=
PULSE_SINK=
# The detector reads this source (same name as PULSE_SOURCE).
ARIA_WAKE_SOURCE=
# The Room page the headless browser opens: a PRODUCTION BUILD served by
# aria-wake-page.service (serve_built.js), proxying /api to the backend.
ARIA_WAKE_PAGE_PORT=3002
ARIA_WAKE_BACKEND=http://127.0.0.1:8092
ARIA_WAKE_FRONTEND=http://localhost:3002
ARIA_WAKE_KIOSK_ID=kio_dc8c06a19608
ARIA_WAKE_PAGE_URL=http://localhost:3002/kiosk/kio_dc8c06a19608?wake=1
# Page origins the listener accepts (must include the page port above).
ARIA_WAKE_ORIGINS=http://localhost:3002,http://127.0.0.1:3002
# Detector tuning (lab-chosen defaults: docs/WAKE_PHRASE_LAB.md).
ARIA_WAKE_KEYWORDS_THRESHOLD=0.15
ARIA_WAKE_KEYWORDS_SCORE=1.0
# Model directory (tokens + three int8 onnx files). Default: ./model next to aria_wake.py
#ARIA_WAKE_MODEL_DIR=
