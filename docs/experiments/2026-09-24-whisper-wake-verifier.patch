+def test_candidate_fails_closed_without_verifier(monkeypatch):
+    server = aw.Server("test-device")
+    monkeypatch.setattr(aw, "VERIFY", True)
+    assert server.verify_candidate(None, "ARIA", np.zeros(1600, dtype=np.float32)) is False
+    monkeypatch.setattr(aw, "VERIFY", False)
+    assert server.verify_candidate(None, "ARIA", np.zeros(1600, dtype=np.float32)) is True
+
