+def test_name_check_accepts_the_name_not_look_alikes():
+    for heard in ["Aria.", "Arya, turn the light off.", "Hey Aria"]:
+        assert aw.VERIFY_NAME.search(heard), heard
+    # Real Room 214 false-wake phrases (2026-09-24) and near misses.
+    for heard in ["that area.", "Is the area clear?", "Are you awake?", "Are ya?",
+                  "underneath her.", "thirteen", "Maria, come here.", "RE are you there?"]:
+        assert not aw.VERIFY_NAME.search(heard), heard
+
