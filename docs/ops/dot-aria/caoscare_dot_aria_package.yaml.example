# Review-ready Home Assistant package. Default off: do not install or expose
# until Michael completes START_HERE.md. The bearer value belongs only in
# Home Assistant secrets.yaml under caoscare_dot_aria_authorization.
rest_command:
  caoscare_dot_aria_profile:
    url: "http://192.168.122.1:8092/api/dot-aria/profile"
    method: GET
    headers:
      authorization: !secret caoscare_dot_aria_authorization
    timeout: 10

  caoscare_dot_aria_departments:
    url: "http://192.168.122.1:8092/api/dot-aria/departments"
    method: GET
    headers:
      authorization: !secret caoscare_dot_aria_authorization
    timeout: 10

  caoscare_dot_aria_menu:
    url: "http://192.168.122.1:8092/api/dot-aria/menu"
    method: POST
    headers:
      authorization: !secret caoscare_dot_aria_authorization
    content_type: "application/json"
    payload: >-
      {{ {"date": date | default(none), "meal_period": meal_period | default(none)} | to_json }}
    timeout: 10

  caoscare_dot_aria_schedule:
    url: "http://192.168.122.1:8092/api/dot-aria/schedule"
    method: POST
    headers:
      authorization: !secret caoscare_dot_aria_authorization
    content_type: "application/json"
    payload: >-
      {{ {"date": date | default(none)} | to_json }}
    timeout: 10

  caoscare_dot_aria_request:
    url: "http://192.168.122.1:8092/api/dot-aria/requests"
    method: POST
    headers:
      authorization: !secret caoscare_dot_aria_authorization
    content_type: "application/json"
    payload: >-
      {{ {"category": category, "summary": summary,
          "priority": priority | default("normal"), "operation_id": operation_id} | to_json }}
    timeout: 10

  caoscare_dot_aria_request_status:
    url: "http://192.168.122.1:8092/api/dot-aria/requests/status"
    method: POST
    headers:
      authorization: !secret caoscare_dot_aria_authorization
    content_type: "application/json"
    payload: >-
      {{ {"request_id": request_id} | to_json }}
    timeout: 10

  caoscare_dot_aria_find_requests:
    url: "http://192.168.122.1:8092/api/dot-aria/requests/find"
    method: POST
    headers:
      authorization: !secret caoscare_dot_aria_authorization
    content_type: "application/json"
    payload: >-
      {{ {"department": department | default(none), "issue": issue | default(none),
          "scope": scope | default("recent"), "limit": limit | default(10) | int,
          "offset": offset | default(0) | int} | to_json }}
    timeout: 10

# Every script returns transport_ok, http_status and the exact CAOSCare body.
# continue_on_error is deliberate: a timeout/unavailable backend becomes an
# explicit transport_ok:false result instead of a false conversational success.
script:
  caoscare_get_my_profile:
    alias: CAOSCare my approved test profile
    icon: mdi:account-check
    description: Read only the single CAOSCare test profile configured by the owner. It cannot search by spoken name or room.
    mode: single
    sequence:
      - action: rest_command.caoscare_dot_aria_profile
        continue_on_error: true
        response_variable: reply
      - variables:
          result:
            transport_ok: "{{ reply is defined }}"
            http_status: "{{ reply.status | default(0) if reply is defined else 0 }}"
            response: "{{ reply.content if reply is defined else {'ok': false, 'error': 'CAOSCare unavailable or timed out'} }}"
      - stop: CAOSCare profile lookup finished
        response_variable: result

  caoscare_get_departments:
    alias: CAOSCare request departments
    icon: mdi:account-group
    description: List active CAOSCare departments that can receive a non-emergency request.
    mode: single
    sequence:
      - action: rest_command.caoscare_dot_aria_departments
        continue_on_error: true
        response_variable: reply
      - variables:
          result:
            transport_ok: "{{ reply is defined }}"
            http_status: "{{ reply.status | default(0) if reply is defined else 0 }}"
            response: "{{ reply.content if reply is defined else {'ok': false, 'error': 'CAOSCare unavailable or timed out'} }}"
      - stop: CAOSCare department lookup finished
        response_variable: result

  caoscare_get_menu:
    alias: CAOSCare menu
    icon: mdi:silverware-fork-knife
    description: Read staff-approved CAOSCare meals. Report an empty result as unavailable information; never invent a meal.
    mode: single
    fields:
      date:
        name: Date
        description: Optional ISO date, YYYY-MM-DD. Omit for the facility date.
        selector: {text: {multiline: false}}
      meal_period:
        name: Meal
        description: Optional breakfast, lunch, or dinner.
        selector: {select: {options: [breakfast, lunch, dinner]}}
    sequence:
      - action: rest_command.caoscare_dot_aria_menu
        continue_on_error: true
        data: {date: "{{ date | default(none) }}", meal_period: "{{ meal_period | default(none) }}"}
        response_variable: reply
      - variables:
          result:
            transport_ok: "{{ reply is defined }}"
            http_status: "{{ reply.status | default(0) if reply is defined else 0 }}"
            response: "{{ reply.content if reply is defined else {'ok': false, 'error': 'CAOSCare unavailable or timed out'} }}"
      - stop: CAOSCare menu lookup finished
        response_variable: result

  caoscare_get_schedule:
    alias: CAOSCare community services and activities
    icon: mdi:calendar-clock
    description: Read published resident-facing CAOSCare activities and community services. Staff-only and draft rows are excluded.
    mode: single
    fields:
      date:
        name: Date
        description: Optional ISO date, YYYY-MM-DD. Omit for the facility date.
        selector: {text: {multiline: false}}
    sequence:
      - action: rest_command.caoscare_dot_aria_schedule
        continue_on_error: true
        data: {date: "{{ date | default(none) }}"}
        response_variable: reply
      - variables:
          result:
            transport_ok: "{{ reply is defined }}"
            http_status: "{{ reply.status | default(0) if reply is defined else 0 }}"
            response: "{{ reply.content if reply is defined else {'ok': false, 'error': 'CAOSCare unavailable or timed out'} }}"
      - stop: CAOSCare schedule lookup finished
        response_variable: result

  caoscare_make_request:
    alias: CAOSCare make test-profile request
    icon: mdi:account-hard-hat
    description: Create one non-emergency CAOSCare request for the server-configured approved test profile. A request receipt is not proof that service started or completed.
    mode: queued
    max: 3
    fields:
      operation_id:
        name: Operation ID
        description: Stable unique ID for this one tool invocation. Reuse it only when retrying the same transport attempt; use a new ID for a genuine repeat request.
        required: true
        selector: {text: {multiline: false}}
      category:
        name: Department
        description: Exact active department slug returned by CAOSCare request departments.
        required: true
        selector: {text: {multiline: false}}
      summary:
        name: Request
        description: Concrete request in the owner's words. Do not invent a time, identity, room, or medical fact.
        required: true
        selector: {text: {multiline: true}}
      priority:
        name: Priority
        description: Use normal unless the owner explicitly indicates another level.
        default: normal
        selector: {select: {options: [low, normal, high, urgent]}}
    sequence:
      - action: rest_command.caoscare_dot_aria_request
        continue_on_error: true
        data:
          operation_id: "{{ operation_id }}"
          category: "{{ category }}"
          summary: "{{ summary }}"
          priority: "{{ priority | default('normal') }}"
        response_variable: reply
      - variables:
          result:
            transport_ok: "{{ reply is defined }}"
            http_status: "{{ reply.status | default(0) if reply is defined else 0 }}"
            response: "{{ reply.content if reply is defined else {'ok': false, 'accepted': false, 'error': 'CAOSCare unavailable or timed out'} }}"
      - stop: CAOSCare request operation finished
        response_variable: result

  caoscare_check_request_status:
    alias: CAOSCare check exact request
    icon: mdi:clipboard-text-clock
    description: Retrieve the resident-safe current state of the exact CAOSCare request ID returned when it was created.
    mode: single
    fields:
      request_id:
        name: Request ID
        description: Exact CAOSCare request_id returned by caoscare_make_request.
        required: true
        selector: {text: {multiline: false}}
    sequence:
      - action: rest_command.caoscare_dot_aria_request_status
        continue_on_error: true
        data: {request_id: "{{ request_id }}"}
        response_variable: reply
      - variables:
          result:
            transport_ok: "{{ reply is defined }}"
            http_status: "{{ reply.status | default(0) if reply is defined else 0 }}"
            response: "{{ reply.content if reply is defined else {'ok': false, 'error': 'CAOSCare unavailable or timed out'} }}"
      - stop: CAOSCare exact request status lookup finished
        response_variable: result

  caoscare_find_my_requests:
    alias: CAOSCare find my requests
    icon: mdi:clipboard-text-search
    description: >-
      Read-only search of the owner's authorized CAOSCare test profile's requests;
      no request ID needed. Use for "did I already ask", open requests, or recent history.
      Returns IDs, summaries, departments, recorded timestamps with timezone, lifecycle
      and notification evidence. Recent includes closed requests. Multiple matches must
      be distinguished. An empty result is not proof no request exists; broaden filters
      and check has_more/next_offset. Never create a request to test this lookup.
    mode: single
    fields:
      department:
        name: Department
        description: Optional department slug, for example maintenance. Omit to search all authorized-profile departments.
        selector: {text: {multiline: false}}
      issue:
        name: Issue
        description: Optional literal words, for example sink. All words must match; not semantic search. Omit to broaden.
        selector: {text: {multiline: false}}
      scope:
        name: Scope
        description: Recent includes open and closed retained requests; open includes only currently open requests.
        default: recent
        selector: {select: {options: [recent, open]}}
      limit:
        name: Page size
        default: 10
        selector: {number: {min: 1, max: 20, step: 1, mode: box}}
      offset:
        name: Page offset
        description: Start at zero; use only the returned next_offset for another page with the same filters.
        default: 0
        selector: {number: {min: 0, max: 1000, step: 1, mode: box}}
    sequence:
      - action: rest_command.caoscare_dot_aria_find_requests
        continue_on_error: true
        data:
          department: "{{ department | default(none) }}"
          issue: "{{ issue | default(none) }}"
          scope: "{{ scope | default('recent') }}"
          limit: "{{ limit | default(10) | int }}"
          offset: "{{ offset | default(0) | int }}"
        response_variable: reply
      - variables:
          result:
            transport_ok: "{{ reply is defined }}"
            http_status: "{{ reply.status | default(0) if reply is defined else 0 }}"
            response: "{{ reply.content if reply is defined else {'ok': false, 'error': 'CAOSCare unavailable or timed out'} }}"
      - stop: CAOSCare read-only request discovery finished
        response_variable: result
