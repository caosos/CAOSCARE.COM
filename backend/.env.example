# CAOS Care backend environment example
# Copy to backend/.env on the server and replace every placeholder.
# Do not commit backend/.env or real secrets.

# Required for backend startup
MONGO_URL=mongodb://localhost:27017
DB_NAME=caoscare
JWT_SECRET=replace-with-long-random-secret

# Safe default: do not create known demo accounts on server/production boot.
# Set true only for local demos or disposable preview environments.
CAOSCARE_ENABLE_DEMO_SEED=false

# Local-development-only owner auth bypass (Terminal 7). Disabled by default.
# When true, requests whose Host header AND client IP both look like
# localhost/LAN dev traffic (see backend/deps.py local_bypass_active) are
# transparently authenticated as the existing owner account, with no
# token/login required. Never activates for public hostnames regardless of
# this value, but only ever set this true on a private local dev machine.
CAOSCARE_LOCAL_OWNER_BYPASS=false


# One-time/manual owner bootstrap. Leave unset except during trusted first-owner creation.
# These are not demo seed values and are never required for normal server startup.
CAOSCARE_BOOTSTRAP_OWNER_EMAIL=owner@example.com
CAOSCARE_BOOTSTRAP_OWNER_NAME=Facility Owner
CAOSCARE_BOOTSTRAP_OWNER_PASSWORD=replace-with-one-time-strong-password

# Public/backend routing
CORS_ORIGINS=https://caoscare.com,https://www.caoscare.com,http://localhost:3000,http://127.0.0.1:3000
PUBLIC_API_URL=https://caoscare.com

# Optional direct AI/provider keys and research
OPENAI_API_KEY=replace-with-openai-key-if-used
OPENAI_TEXT_MODEL=gpt-4o-mini
OPENAI_REALTIME_MODEL=gpt-realtime
OPENAI_VOICE=sage
PERPLEXITY_API_KEY=replace-with-perplexity-key-if-used

# Optional notification providers; blank/log-only is acceptable for first run
TWILIO_ACCOUNT_SID=replace-with-twilio-account-sid-if-used
TWILIO_AUTH_TOKEN=replace-with-twilio-auth-token-if-used
TWILIO_FROM_NUMBER=replace-with-twilio-from-number-if-used
RESEND_API_KEY=replace-with-resend-api-key-if-used
RESEND_FROM_EMAIL=onboarding@example.com

# Optional facility defaults used by weather/realtime prompts
FACILITY_LABEL=the facility
FACILITY_TZ=America/New_York
FACILITY_LAT=40.0379
FACILITY_LON=-76.3055

# Optional device/hardware settings
DEVICE_AUTH_REQUIRED=false
RECEIPT_SIGNING_SECRET=replace-with-long-random-receipt-secret

# Optional Home Assistant adapter (device_adapters.py) - only needed for a
# SmartDevice with protocol="home_assistant". Blank/unset means that
# adapter is not configured; devices stay on protocol="mock" or a
# physical-transport protocol until this is set AND a device's `endpoint`
# is a real HA entity_id.
HA_BASE_URL=http://192.168.122.137:8123
HA_TOKEN=replace-with-a-home-assistant-long-lived-access-token
