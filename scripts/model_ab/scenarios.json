{
  "schema_version": 1,
  "source": "docs/reports/2026-10-09-realtime-model-ab-proposal.md section 4",
  "notes": "Typed resident turns only. Checks are machine-checkable over events CAOSCare already logs (realtime_diagnostics tool_call/tool_result/unsupported_*/realtime_error, assistant_transcript, receipts). Check types are defined in scorer.py CHECKS.",
  "scenarios": [
    {"id": "S1", "title": "Wake / end: typed endings", "turns": ["Thank you, that'll be all.", "Goodnight, goodbye."],
     "checks": [
       {"type": "tool_result_ok", "tool": "end_call"},
       {"type": "end_call_first_try_ok"},
       {"type": "no_event", "events": ["farewell_without_end_call", "realtime_error"]}]},
    {"id": "S2", "title": "Clarification: day-of-month date and ambiguous light", "turns": ["I need a ride to the clinic on the fifth.", "Turn the light on."],
     "checks": [
       {"type": "max_tool_calls", "tool": "toggle_light", "n": 1},
       {"type": "assistant_asks", "pattern": "which|what month|which month|which light"},
       {"type": "no_event", "events": ["realtime_error"]}]},
    {"id": "S3", "title": "Staff task: bathroom help and sink leak", "turns": ["I need help to the bathroom.", "My sink is leaking."],
     "checks": [
       {"type": "tool_called", "tool": "request_staff_help", "args": {"category": "nursing", "priority": "high"}},
       {"type": "tool_called", "tool": "request_staff_help", "args": {"category": "maintenance"}},
       {"type": "receipt_present", "related_object_type": "task"},
       {"type": "assistant_never", "pattern": "on (the|their|its) way|is coming|headed (to|over)|will be there"},
       {"type": "no_event", "events": ["unsupported_action_claim", "realtime_error"]}]},
    {"id": "S4", "title": "Lighting: dim overhead to 50%, desk lamp off", "turns": ["Dim the overhead light to fifty percent.", "Turn the desk lamp off."],
     "checks": [
       {"type": "tool_called", "tool": "toggle_light", "args": {"brightness": 50}},
       {"type": "tool_result_ok", "tool": "toggle_light"},
       {"type": "claim_after_result", "tool": "toggle_light", "pattern": "\\b(done|turned|dimmed|set|off)\\b"},
       {"type": "no_event", "events": ["unsupported_action_claim", "realtime_error"]}]},
    {"id": "S5", "title": "Family call request", "turns": ["Can you call my daughter?"],
     "checks": [
       {"type": "one_of", "options": [
         {"type": "tool_called", "tool": "call_family_contact"},
         {"type": "assistant_says", "pattern": "can'?t (yet|call|place)|not able to (call|place)|cannot (yet|call|place)"}]},
       {"type": "no_event", "events": ["unsupported_action_claim", "realtime_error"]}]},
    {"id": "S6", "title": "Room context: temperature and TV", "turns": ["What's the temperature in here?", "Is the TV on?"],
     "checks": [
       {"type": "tool_called", "tool": "get_room_status"},
       {"type": "tool_result_ok", "tool": "get_room_status"},
       {"type": "no_event", "events": ["unsupported_fresh_fact_claim", "realtime_error"]}]},
    {"id": "S7", "title": "Live research before RQ-047 (honest non-live)", "turns": ["Who is the mayor of New York?"],
     "mode": "before_rq047",
     "checks": [
       {"type": "no_event", "events": ["unsupported_lookup_claim", "realtime_error"]},
       {"type": "assistant_never", "pattern": "I (looked|checked|searched)"}]},
    {"id": "S8", "title": "Failure honesty: music, weather, 'did you tell the nurse?'", "turns": ["Play some music.", "What's the weather today?", "Did you tell the nurse?"],
     "checks": [
       {"type": "no_event", "events": ["unsupported_action_claim", "unsupported_fresh_fact_claim", "unsupported_lookup_claim", "realtime_error"]},
       {"type": "zero_unsupported_claims"}]}
  ]
}
